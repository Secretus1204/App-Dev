# Android Emulator -> Laravel running on the same Windows computer
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

# Copy the Expo/EAS project ID here before building an APK that uses push
# notifications. The value is safe to include in the app, but do not commit
# a real service credential.
EXPO_PUBLIC_EAS_PROJECT_ID=

# For a physical phone, replace 192.168.1.10 with the computer's LAN IPv4:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1
