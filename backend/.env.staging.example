APP_NAME="Library Management System"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://api-staging.example.com

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=staging-db.example.com
DB_PORT=3306
DB_DATABASE=library_management_staging
DB_USERNAME=replace-with-staging-db-user
DB_PASSWORD=replace-with-secret-manager-value

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local
MAIL_MAILER=log

CORS_ALLOWED_ORIGINS=https://admin-staging.example.com

LIBRARY_DEFAULT_LOAN_DAYS=14
LIBRARY_MAX_ACTIVE_LOANS=3
LIBRARY_DUE_SOON_DAYS=2
LIBRARY_REQUIRE_EMAIL_VERIFICATION=false
LIBRARY_REQUIRE_MEMBER_APPROVAL=false

# Set these only in the deployment secret store when creating the first real
# Admin. Remove or rotate them immediately after the one-time seed.
LIBRARY_FIRST_ADMIN_NAME=
LIBRARY_FIRST_ADMIN_EMAIL=
LIBRARY_FIRST_ADMIN_PASSWORD=
